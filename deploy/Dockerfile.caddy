# Custom Caddy build with rate-limiting module.
# Images are pinned by digest and the plugin by commit, so a rebuild cannot pull
# in code that nobody reviewed. Dependabot (docker ecosystem) proposes image updates;
# the plugin commit is bumped by hand.
FROM caddy:2-builder@sha256:aef223d1f943bc12a29a9e0a0a73983aa19a36672daede7507da4201a6b1016a AS builder

RUN xcaddy build \
    --with github.com/mholt/caddy-ratelimit@5625512f24f6f59d6f64fb3aafe5eecff0b286db

FROM caddy:2-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
